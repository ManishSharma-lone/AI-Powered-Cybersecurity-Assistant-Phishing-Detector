# ==========================================
# AI Phishing Assistant - Environment Config
# ==========================================

# Optional: Groq Cloud API Key for LLM explanations (Free Tier: https://console.groq.com)
# If left empty, the application uses its built-in offline Heuristic Analysis Engine!
GROQ_API_KEY=

# Optional: Groq Model Selection (Defaults to Qwen 3.8 27B)
GROQ_MODEL=qwen/qwen3.8-27b

# Server Port and Host
HOST=127.0.0.1
PORT=8000
